# Copy outside Git. Use DNS names without scheme, port or trailing slash.
APP_HOST=app.example.org
AUTH_HOST=auth.example.org
PRIVATE_DIR=/etc/stockpilot-vps/private
# Numeric group owning the generated BFF configuration and TLS private key.
RUNTIME_GID=1000
EDGE_SUBNET=172.31.249.0/27
EDGE_POOL=172.31.249.16/28
PROXY_IP=172.31.249.2
# Keep loopback during acceptance. Deliberately select a public address for ingress.
HTTPS_BIND=127.0.0.1
HTTPS_PORT=443
# Empty disables the assistant. Set a private, trusted HTTPS endpoint before prepare.
INFERENCE_URL=
