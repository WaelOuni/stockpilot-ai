server {
  # Existing CSV accepts 4096-character SKUs; UTF-8 percent encoding can take 49KiB.
  # Bound the request line while preserving those exact identifiers.
  large_client_header_buffers 2 64k;
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  location = /healthz { access_log off; return 200 'UP'; }
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  location /api/backoffice/products/import/ {
    # Match the existing hard CSV ceiling; the application enforces its lower configured limit.
    client_max_body_size 16m;
    proxy_pass ${API_UPSTREAM}/backoffice/products/import/;
  }
  location /api/ {
    client_max_body_size 1m;
    proxy_pass ${API_UPSTREAM}/;
  }
  location / {
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    try_files $uri $uri/ /index.html;
  }
}
