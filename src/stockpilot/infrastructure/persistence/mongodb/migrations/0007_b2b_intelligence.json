{
  "version": 7,
  "id": "0007_b2b_intelligence",
  "description": "Add qualified daily commercial facts and documented supply assumptions; no historical backfill",
  "collections": [
    {
      "collection": "b2b_demand_days",
      "options": {
        "collation": {
          "locale": "simple"
        },
        "validationLevel": "strict",
        "validationAction": "error",
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "additionalProperties": false,
            "required": [
              "_id",
              "organization_id",
              "product_id",
              "source_references",
              "day",
              "sold",
              "returned",
              "cancelled",
              "reserved",
              "received",
              "transferred",
              "adjusted",
              "complete",
              "stockout",
              "dataset"
            ],
            "properties": {
              "_id": {
                "bsonType": "objectId"
              },
              "organization_id": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^\\S(?:.*\\S)?$"
              },
              "product_id": {
                "bsonType": "string",
                "pattern": "^[0-9a-f]{24}$"
              },
              "source_references": {
                "bsonType": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "bsonType": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "day": {
                "bsonType": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "sold": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "returned": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "cancelled": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "reserved": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "received": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "transferred": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "adjusted": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": -1000000000,
                "maximum": 1000000000
              },
              "complete": {
                "bsonType": "bool"
              },
              "stockout": {
                "bsonType": "bool"
              },
              "dataset": {
                "enum": [
                  "observed",
                  "DEMO_SYNTHETIC"
                ]
              }
            }
          }
        }
      },
      "indexes": [
        {
          "name": "b2b_demand_days_identity",
          "key": [
            [
              "organization_id",
              1
            ],
            [
              "product_id",
              1
            ],
            [
              "day",
              1
            ]
          ],
          "unique": true
        }
      ]
    },
    {
      "collection": "b2b_analytics_profiles",
      "options": {
        "collation": {
          "locale": "simple"
        },
        "validationLevel": "strict",
        "validationAction": "error",
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "additionalProperties": false,
            "required": [
              "_id",
              "organization_id",
              "product_id",
              "source_references",
              "currency"
            ],
            "properties": {
              "_id": {
                "bsonType": "objectId"
              },
              "organization_id": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^\\S(?:.*\\S)?$"
              },
              "product_id": {
                "bsonType": "string",
                "pattern": "^[0-9a-f]{24}$"
              },
              "source_references": {
                "bsonType": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "bsonType": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "currency": {
                "bsonType": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "unit_cost_minor": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "supplier": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "lead_time_days": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 90
              },
              "safety_stock": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "minimum_order_quantity": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 1,
                "maximum": 1000000000
              },
              "incoming_confirmed": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0,
                "maximum": 1000000000
              },
              "incoming_as_of": {
                "bsonType": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      },
      "indexes": [
        {
          "name": "b2b_analytics_profiles_identity",
          "key": [
            [
              "organization_id",
              1
            ],
            [
              "product_id",
              1
            ]
          ],
          "unique": true
        }
      ]
    }
  ]
}
