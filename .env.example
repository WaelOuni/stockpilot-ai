# Local development only. Export values explicitly; Settings does not load .env.
# production / production_saas always close sensitive APIs until SaaS prerequisites exist.
DEPLOYMENT_ENVIRONMENT=development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MONGO_URI='mongodb://localhost:27017/?replicaSet=rs0&directConnection=true'
MONGO_DATABASE=stockpilot
# Back-office endpoints stay disabled (503) until a non-empty secret is exported.
# Generate a local secret; never commit its value. Settings does not load .env.
# BACKOFFICE_API_TOKEN=
# Generate a separate signing secret; never reuse the back-office token.
# CUSTOMER_JWT_SECRET=
# Optional local token context: configure issuer and audience together.
# CUSTOMER_JWT_ISSUER=
# CUSTOMER_JWT_AUDIENCE=
# Public credentials of the local Compose demo, never production credentials.
POSTGRES_URL=postgresql://stockpilot:stockpilot@localhost:5432/stockpilot
# If unset, checkpoint storage uses POSTGRES_URL.
# LANGGRAPH_CHECKPOINT_DB_URI=postgresql://USER:PASSWORD@HOST:5432/DATABASE
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stockpilot-ai
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
LOG_LEVEL=INFO
LOG_FILE=logs/stockpilot.jsonl
