# Local demo only. Export these values explicitly; Settings does not load .env.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MONGO_URI='mongodb://localhost:27017/?replicaSet=rs0&directConnection=true'
MONGO_DATABASE=stockpilot
# Back-office endpoints stay disabled (503) until a non-empty secret is exported.
# Generate a local secret; never commit its value. Settings does not load .env.
# BACKOFFICE_API_TOKEN=
# Generate a separate signing secret; never reuse the back-office token.
# CUSTOMER_JWT_SECRET=
# Public credentials of the local Compose demo, never production credentials.
POSTGRES_URL=postgresql://stockpilot:stockpilot@localhost:5432/stockpilot
# If unset, checkpoint storage uses POSTGRES_URL.
# LANGGRAPH_CHECKPOINT_DB_URI=postgresql://USER:PASSWORD@HOST:5432/DATABASE
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stockpilot-ai
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
LOG_LEVEL=INFO
LOG_FILE=logs/stockpilot.jsonl

# Input/resource limits (local process protection; not a distributed SaaS quota).
HTTP_BODY_MAX_BYTES=131072
# Wall-clock budget to receive the JSON/body, ending before any workflow dispatch.
HTTP_BODY_TIMEOUT_SECONDS=10
API_MESSAGE_MAX_CHARS=8000
API_THREAD_MAX_CHARS=128
# Order/operation IDs only; exact SKU/name keeps the existing CSV ceiling (4096).
API_IDENTIFIER_MAX_CHARS=256
CONVERSATION_MAX_INFLIGHT=4
OLLAMA_MAX_PROMPT_BYTES=65536
# HTTPX connect/read/write/pool inactivity budget, not whole-workflow timeout.
OLLAMA_TIMEOUT_SECONDS=60
